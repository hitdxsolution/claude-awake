{
  "name": "claude-awake",
  "version": "1.0.0",
  "description": "Keep your computer awake while the Claude desktop app is running. Cross-platform (macOS & Windows), single binary, no runtime required on the target machine.",
  "type": "module",
  "bin": {
    "claude-awake": "./index.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"**/*.{ts,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md}\"",
    "build:mac-arm64": "bun build ./index.ts --compile --target=bun-darwin-arm64 --outfile dist/claude-awake-macos-arm64",
    "build:mac-x64": "bun build ./index.ts --compile --target=bun-darwin-x64 --outfile dist/claude-awake-macos-x64",
    "build:win-x64": "bun build ./index.ts --compile --target=bun-windows-x64 --outfile dist/claude-awake-windows-x64.exe",
    "build": "bun run typecheck && bun run lint:check && bun run build:mac-arm64 && bun run build:mac-x64 && bun run build:win-x64"
  },
  "keywords": [
    "caffeine",
    "keep-awake",
    "no-sleep",
    "insomnia",
    "claude",
    "macos",
    "windows",
    "cross-platform"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
